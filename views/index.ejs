
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create User</title>

    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body>
    <div class="w-full min-h-screen bg-zinc-900 text-white p-10">
        <div class="nav mb-10">
            <a class="text-blue-500 hover:text-blue-600" href="/read">All User</a>
        </div>
        <h1 class="text-3xl font-bold tracking-tight mb-5">
            Create User
        </h1>

        <form action="/create" method="POST" class="flex flex-col gap-4 max-w-md">

            <input
                class="px-5 py-2 bg-transparent border border-zinc-700 rounded-md outline-none focus:border-blue-500"
                type="text"
                name="name"
                placeholder="Enter your name"
            >

            <input
                class="px-5 py-2 bg-transparent border border-zinc-700 rounded-md outline-none focus:border-blue-500"
                type="email"
                name="email"
                placeholder="Enter your email"
            >

            <input
                class="px-5 py-2 bg-transparent border border-zinc-700 rounded-md outline-none focus:border-blue-500"
                type="text"
                name="image"
                placeholder="Enter image URL"
            >

            <input
                class="px-5 py-2 bg-blue-500 hover:bg-blue-600 rounded-md cursor-pointer"
                type="submit"
                value="Create User"
            >

        </form>
    </div>
</body>
</html>