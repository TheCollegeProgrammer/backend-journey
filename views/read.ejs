
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create User</title>

    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body>
    <div class="w-full min-h-screen bg-zinc-900 text-white p-10">
        <div class="nav mb-10">
            <a class="text-blue-500 hover:text-blue-600" href="/">Create User</a>
        </div>
        <h1 class="text-3xl font-bold tracking-tight mb-5">
            All User
        </h1>
        <% if (users.length === 0) { %>
            <h3 class="text-zinc-500">No users found.</h3>
        <% } %>
        <div class="flex gap-5">
            <% users.forEach((user) => { %>
                <div class="flex-wrap users">
                    <div class="user w-72 p-4 bg-zinc-800 rounded-lg">
                        <div class="w-full h-65 rounded-lg overflow-hidden mb-4 center">
                            <img src="<%= user.image %>" alt="User Image" class="w-full h-full object-cover">
                        </div>
                        <h3 class="text-xl mt-3 tracking-tighter"><%= user.name %></h3>
                        <h5 class="text-zinc-500"><%= user.email %></h5>
                        <div class="flex gap-3 mt-6">
                            <a class="text-zinc-600" href="/update/<%= user._id %>">Edit</a>
                            <a class="text-red-500" href="/delete/<%= user._id %>">Delete</a>
                        </div>
                    </div>
                </div>
            <% }) %>

        </div>
    </div>
</body>
</html>